# ── Supabase (хмарне збереження + акаунти) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Push-нагадування ─────────────────────────────────────────────────
# Пара VAPID-ключів. Згенерувати один раз:
#   npx web-push generate-vapid-keys
# Публічний іде і в браузер, і на сервер; приватний — ТІЛЬКИ на сервер.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:self.farm.game@gmail.com

# Ключ Supabase з правами service_role: ним розсилка читає підписки
# в обхід RLS. Ніколи не з префіксом NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Пароль до /api/push/send. Згенерувати: openssl rand -hex 32
CRON_SECRET=
